{
  "name": "roveterm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "check:branch": "node scripts/git-workflow.mjs branch",
    "check:commit": "node scripts/git-workflow.mjs commit-msg",
    "test:workflow": "node --test scripts/git-workflow.test.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "release:bump": "node scripts/release.mjs bump",
    "release:prepare": "node scripts/release.mjs prepare",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "check:ui": "svelte-check --workspace ui --tsconfig ./tsconfig.json",
    "check:docs": "node scripts/check-docs.mjs",
    "test:ui": "node --experimental-strip-types --no-warnings --test \"ui/src/lib/**/*.test.ts\"",
    "build:windows": "XWIN_ACCEPT_LICENSE=1 tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "lucide-static": "1.61.0",
    "marked": "18.2.0",
    "simple-icons": "16.35.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@tsconfig/svelte": "5.0.8",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
